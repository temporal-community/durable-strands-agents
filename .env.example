# AWS credentials for Bedrock model access (or use `aws configure` / an AWS_PROFILE instead)
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Temporal server address (defaults to local dev server)
TEMPORAL_ADDRESS=localhost:7233

# Task queue name, override to run multiple demo instances side by side
DEMO_TASK_QUEUE=durable-strands-agents-tq

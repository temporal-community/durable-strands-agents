.env

# Generated social-share assets — not part of the repo history
docs/durable-strands-agents.gif
docs/durable-strands-agents.mp4
.DS_Store
docs/.DS_Store

# Generated by `agentcore create`/`agentcore deploy` inside bin/create-runtime.sh — reads
# agentcore.json/aws-targets.json at synth time, holds nothing sample-specific
agentcore/cdk
agentcore/.cli
# `agentcore deploy`'s CodeZip build stages a full copy of this directory here to zip it,
# including .env (real secrets) — never let this get anywhere near `git add -A`/`git add agentcore`
agentcore/.cache

# Real runtime config, with real secrets in envVars — copy from
# agentcore.json.example and fill in before running bin/create-runtime.sh
agentcore/agentcore.json

